# URL base da aplicação admin (Next.js + Supabase)
PUBLIC_API_BASE_URL=https://[DOMINIO_DA_APP]

# Número do WhatsApp da Fazenda (com código do país, sem espaços)
PUBLIC_WHATSAPP_NUMBER=5571999990000

# ID do vídeo no YouTube para a seção VSL (ex: dQw4w9WgXcQ)
PUBLIC_YOUTUBE_VSL_ID=

# Meta Ads Pixel ID (deixar vazio para desativar)
PUBLIC_META_PIXEL_ID=

# Google Ads / GA4 Measurement ID (ex: G-XXXXXXXXXX ou AW-XXXXXXXXX)
PUBLIC_GOOGLE_ADS_ID=

# URL do gateway de pagamento para Day Use (deixar vazio para ocultar o botão)
PUBLIC_DAYUSE_PAYMENT_URL=
