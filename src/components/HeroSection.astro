---
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '5571999990000';
const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('[Site] Olá! Tenho interesse em fazer uma reserva na Fazenda Hotel Candeal.')}`;
---

<section id="hero" class="relative min-h-[95vh] flex flex-col overflow-hidden bg-primary-dark">

  <!-- Foto de fundo real da fazenda -->
  <img
    src="/images/hotel_fazenda_candeal_quartos_externos.jpg"
    alt="Fazenda Hotel Candeal"
    class="absolute inset-0 w-full h-full object-cover"
    style="object-position: center 50%;"
    loading="eager"
  />

  <!-- Overlay gradiente: escurece esquerda para legibilidade, mostra foto à direita -->
  <div class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(to right, rgba(10,34,24,0.78) 0%, rgba(10,34,24,0.70) 40%, rgba(10,34,24,0.50) 70%, rgba(10,34,24,0.30) 100%);"></div>
  <!-- Overlay vertical: mais escuro embaixo para transição suave -->
  <div class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(to top, rgba(10,34,24,0.6) 0%, transparent 40%);"></div>

  <!-- Conteúdo principal -->
  <div class="relative z-10 flex-1 flex items-center">
    <div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16 lg:py-24">
      <div class="grid lg:grid-cols-[58fr_42fr] gap-8 lg:gap-16 items-center">

        <!-- COLUNA ESQUERDA: headline + CTAs -->
        <div class="flex flex-col items-start">
          <!-- Localização badge -->
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-white/80 text-sm mb-7 backdrop-blur-sm" style="animation: fadeSlideUp 0.7s ease 0.1s both;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-accent-light shrink-0">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Conceição do Jacuípe, Bahia</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[4.25rem] font-bold text-white leading-[1.08] mb-6 tracking-tight" style="animation: fadeSlideUp 0.8s ease 0.25s both;">
            Uma experiência de fazenda que sua família <span class="text-accent-light">não vai esquecer</span>
          </h1>

          <p class="text-white/70 text-lg leading-relaxed mb-10 max-w-lg" style="animation: fadeSlideUp 0.7s ease 0.4s both;">
            Gastronomia regional com pensão completa, natureza preservada,
            trilhas, piscina e muito conforto a poucos quilômetros de Salvador.
          </p>

          <div class="flex flex-col sm:flex-row gap-4" style="animation: fadeSlideUp 0.7s ease 0.55s both;">
            <a
              href="#reserva"
              class="inline-flex items-center justify-center gap-2 font-bold px-8 py-4 rounded-xl text-base transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-white"
              style="background: linear-gradient(135deg, #b7791f 0%, #d4952a 100%);"
            >
              Ver datas disponíveis
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>

            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 border border-white/30 hover:border-white/60 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-xl text-base transition-all duration-200 backdrop-blur-sm"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Tirar dúvidas
            </a>
          </div>
        </div>

        <!-- COLUNA DIREITA: glass card com tudo incluso -->
        <div class="flex items-center justify-center lg:justify-end" style="animation: fadeSlideUp 0.8s ease 0.35s both;">
          <div class="w-full max-w-sm rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.4)]" style="background: rgba(255,255,255,0.07); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.18);">
            <!-- Header do card -->
            <div class="px-7 py-5" style="background: linear-gradient(135deg, #b7791f 0%, #d4952a 100%);">
              <p class="text-white text-xl font-bold leading-tight">Tudo incluso na sua estada</p>
              <p class="text-white/80 text-xs mt-1">Pensão completa + lazer + natureza</p>
            </div>
            <!-- Lista de itens -->
            <div class="px-7 py-6">
              <ul class="space-y-4">
                {[
                  { icon: '🍽️', text: 'Café da manhã, almoço e jantar' },
                  { icon: '🏊', text: 'Piscina & área de lazer' },
                  { icon: '👧', text: 'Monitoria infantil inclusa' },
                  { icon: '🌿', text: 'Trilhas e atividades na natureza' },
                  { icon: '🛏️', text: 'Quarto com AC, frigobar e TV' },
                  { icon: '📶', text: 'WiFi em toda a fazenda' },
                ].map((item) => (
                  <li class="flex items-center gap-3 text-white text-sm font-medium">
                    <span class="text-base shrink-0">{item.icon}</span>
                    {item.text}
                  </li>
                ))}
              </ul>
              <a
                href="#reserva"
                class="mt-6 block w-full text-center font-bold px-6 py-4 rounded-xl text-sm transition-all duration-200 shadow-md"
                style="background: white; color: #1b4332;"
                onmouseover="this.style.background='#d4952a'; this.style.color='white';"
                onmouseout="this.style.background='white'; this.style.color='#1b4332';"
              >
                Ver datas e reservar
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Strip inferior: distâncias e benefícios -->
  <div class="relative z-10 border-t border-white/10" style="background: rgba(10,34,24,0.7); backdrop-filter: blur(8px);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-3 divide-x divide-white/10">

        <div class="reveal px-4 py-5 flex flex-col sm:flex-row items-center sm:justify-center gap-3" data-delay="1">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(183,121,31,0.25); border: 1px solid rgba(183,121,31,0.4);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f6ad55" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
              <circle cx="12" cy="9" r="2.5"/>
            </svg>
          </div>
          <div class="text-center sm:text-left">
            <p class="text-accent-light text-lg sm:text-xl font-bold leading-none">100 km</p>
            <p class="text-white/50 text-[10px] sm:text-xs uppercase tracking-wide mt-0.5">de Salvador</p>
          </div>
        </div>

        <div class="reveal px-4 py-5 flex flex-col sm:flex-row items-center sm:justify-center gap-3" data-delay="2">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(183,121,31,0.25); border: 1px solid rgba(183,121,31,0.4);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f6ad55" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
              <circle cx="12" cy="9" r="2.5"/>
            </svg>
          </div>
          <div class="text-center sm:text-left">
            <p class="text-accent-light text-lg sm:text-xl font-bold leading-none">30 km</p>
            <p class="text-white/50 text-[10px] sm:text-xs uppercase tracking-wide mt-0.5">de Feira de Santana</p>
          </div>
        </div>

        <div class="reveal px-4 py-5 flex flex-col sm:flex-row items-center sm:justify-center gap-3" data-delay="3">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(183,121,31,0.25); border: 1px solid rgba(183,121,31,0.4);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f6ad55" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2M7 2v20M21 15V2a5 5 0 00-5 5v6h3.5a.5.5 0 01.5.5V20a2 2 0 004 0V15z"/>
            </svg>
          </div>
          <div class="text-center sm:text-left">
            <p class="text-accent-light text-lg sm:text-xl font-bold leading-none">3 refeições</p>
            <p class="text-white/50 text-[10px] sm:text-xs uppercase tracking-wide mt-0.5">por dia inclusas</p>
          </div>
        </div>

      </div>
    </div>
  </div>

</section>

<!-- Para usar uma foto local (melhor performance), coloque em /public/images/hero.jpg
     e troque a src da img acima para: src="/images/hero.jpg" -->
