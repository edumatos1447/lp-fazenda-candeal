---
const testimonials = [
  {
    name: 'Manoel Vitor',
    title: 'Ideal para crianças',
    text: 'Local maravilhoso para as crianças. Bastante área verde e diversos brinquedos. Possuem atrações programadas durante a estadia, incluindo passeios pela fazenda e brincadeiras, todas com a presença de monitoria. Comida saborosa e diversificada. Ideal para famílias. Além disso, a história da fazenda, com a presença da Sra. Amabília Almeida, torna a experiência ainda mais interessante.',
    initials: 'MV',
  },
  {
    name: 'Claudiane',
    text: 'Bastante espaço verde e com segurança para as crianças brincarem à vontade.',
    initials: 'CL',
  },
  {
    name: 'Larissa',
    text: 'Excelente hotel fazenda, com muitas atividades pras crianças! A comida é muito saborosa e diversificada. A animação é excelente, com Dedêra, as crianças se divertiram o dia todo! O futebol de sabão e o parque aquático são muito divertidos! O contato com os animais é muito bom pras crianças. Tudo muito bem cuidado! O parquinho de areia e a brinquedoteca perto do restaurante são ótimos!',
    initials: 'LA',
  },
  {
    name: 'Juliana',
    text: 'Quartos limpos, roupas de cama e toalhas limpas e cheirosas. Bom espaço.',
    initials: 'JU',
  },
  {
    name: 'Araujo',
    text: 'Fomos tratados como se fôssemos da família, comida deliciosa, bom espaço para as crianças brincarem, os quartos limpos diariamente, com certeza voltaremos em breve.',
    initials: 'AR',
  },
];

const [featured, ...rest] = testimonials;
---

<section class="py-24" style="background: linear-gradient(180deg, #f7f3eb 0%, #faf9f5 100%);">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="reveal text-center mb-16">
      <span class="section-eyebrow">Depoimentos</span>
      <h2 class="font-serif text-4xl sm:text-5xl text-ink mt-3 mb-5">
        O que dizem nossos hóspedes
      </h2>
      <div class="decorative-rule mx-auto"></div>
    </div>

    <!-- Depoimento em destaque -->
    <div class="reveal relative mb-14 px-4 sm:px-10">
      <span class="font-serif text-[5rem] sm:text-[7rem] leading-none text-accent/15 absolute -top-4 -left-2 select-none pointer-events-none">"</span>
      <blockquote class="relative z-10">
        <p class="font-sans text-lg sm:text-xl text-ink leading-relaxed mb-7">
          "{featured.text}"
        </p>
        <footer class="flex items-center gap-4 flex-wrap">
          <div class="w-11 h-11 rounded-full bg-primary flex items-center justify-center text-white text-sm font-bold shrink-0">
            {featured.initials}
          </div>
          <div>
            <cite class="font-sans font-semibold text-ink text-sm not-italic block">{featured.name}</cite>
            {featured.title && <p class="font-sans text-text-muted text-xs">{featured.title}</p>}
          </div>
          <div class="flex gap-0.5 text-accent ml-auto text-lg" aria-label="5 estrelas">
            ★★★★★
          </div>
        </footer>
      </blockquote>
    </div>

    <!-- Divisória -->
    <div class="border-t border-divider mb-12"></div>

    <!-- 4 depoimentos menores -->
    <div class="grid sm:grid-cols-2 gap-8 mb-14">
      {rest.map((t, i) => (
        <div class="reveal flex flex-col" data-delay={String((i % 4) + 1)}>
          <span class="font-serif text-4xl text-accent/25 leading-none mb-3">"</span>
          <p class="font-sans text-text-muted text-sm leading-relaxed flex-1 mb-5">"{t.text}"</p>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-primary/80 flex items-center justify-center text-white text-xs font-bold shrink-0">
              {t.initials}
            </div>
            <div>
              <p class="font-sans font-semibold text-ink text-sm leading-tight">{t.name}</p>
              <div class="flex gap-0.5 text-accent text-sm" aria-label="5 estrelas">★★★★★</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Badge avaliação -->
    <div class="reveal flex justify-center">
      <div class="inline-flex items-center gap-3 bg-[#003580] text-white rounded-lg px-6 py-3 text-sm font-medium">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Avaliação excelente no Booking.com
      </div>
    </div>

  </div>
</section>
