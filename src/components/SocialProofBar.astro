---
---

<section class="text-white py-5" style="background: linear-gradient(90deg, #112f23 0%, #1b4332 50%, #112f23 100%);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="reveal flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">

      <!-- Estrelas -->
      <div class="flex items-center gap-2">
        <span class="text-accent-light text-base tracking-tight">★★★★★</span>
        <span class="text-white/60 text-xs">Booking.com</span>
      </div>

      <span class="hidden sm:block w-px h-4 bg-white/15"></span>

      <!-- Localização -->
      <div class="flex items-center gap-1.5 text-white/75">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-accent-light shrink-0">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Conceição do Jacuípe, BA</span>
      </div>

      <span class="hidden sm:block w-px h-4 bg-white/15"></span>

      <!-- Pensão completa -->
      <div class="flex items-center gap-1.5 text-white/75">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-accent-light shrink-0">
          <path d="M18.06 22.99h1.66c.84 0 1.53-.64 1.63-1.46L23 5.05h-5V1h-1.97v4.05h-4.97l.3 2.34c1.71.47 3.31 1.32 4.27 2.26 1.44 1.42 2.43 2.89 2.43 5.29v8.05zM1 21.99V21h15.03v.99c0 .55-.45 1-1.01 1H2.01c-.56 0-1.01-.45-1.01-1zm15.03-7c0-8-15.03-8-15.03 0h15.03zM1.02 17h15v2h-15z"/>
        </svg>
        <span>Pensão completa inclusa</span>
      </div>

      <span class="hidden sm:block w-px h-4 bg-white/15"></span>

      <!-- Monitoria -->
      <div class="flex items-center gap-1.5 text-white/75">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-accent-light shrink-0">
          <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
        </svg>
        <span>Monitoria infantil inclusa</span>
      </div>

      <span class="hidden sm:block w-px h-4 bg-white/15"></span>

      <!-- WiFi -->
      <div class="flex items-center gap-1.5 text-white/75">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-accent-light shrink-0">
          <path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/>
        </svg>
        <span>WiFi em toda a fazenda</span>
      </div>

    </div>
  </div>
</section>
