---
const escolarNumber = import.meta.env.PUBLIC_WHATSAPP_ESCOLAR_NUMBER || '5571993043763';
const waUrl = `https://wa.me/${escolarNumber}?text=${encodeURIComponent('Olá! Vim através do anúncio sobre Day Use Escolar. Gostaria de mais informações')}`;

const beneficios = [
  {
    emoji: '🌱',
    title: 'Atividades agroecológicas',
    desc: 'Os alunos colocam a mão na terra e descobrem na prática como nascem os alimentos, da horta ao prato.',
  },
  {
    emoji: '👧',
    title: 'Monitoria infantil',
    desc: 'Nossa equipe acompanha a turma do começo ao fim do passeio, com gincanas e brincadeiras dirigidas.',
  },
  {
    emoji: '🎯',
    title: 'Infraestrutura de lazer completa',
    desc: 'Espaços amplos, áreas de convivência e toda a estrutura preparada para receber turmas com conforto e segurança.',
  },
  {
    emoji: '🏊',
    title: 'Piscina com toboágua',
    desc: 'A atração preferida da criançada, com área de descanso ao redor para professores e acompanhantes.',
  },
  {
    emoji: '🐴',
    title: 'Animais e contato com a natureza',
    desc: 'Visita aos animais da fazenda, trilhas e passeio de charrete em meio ao verde.',
  },
];
---

<section id="day-use-escolar" class="py-24 bg-bg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Cabeçalho -->
    <div class="reveal text-center mb-14">
      <span class="section-eyebrow">Para escolas</span>
      <h2 class="font-serif text-4xl sm:text-5xl text-ink mt-3 mb-4">Day Use Escolar</h2>
      <p class="text-text-muted text-lg max-w-2xl mx-auto font-sans leading-relaxed">
        A turma troca a sala de aula por um dia inteiro na fazenda. São horas de programação
        pedagógica, monitoria dedicada e diversão ao ar livre, tudo em uma única visita, sem
        necessidade de hospedagem.
      </p>
      <div class="decorative-rule mx-auto mt-6"></div>
    </div>

    <!-- Benefícios -->
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3">
      {beneficios.map((b, i) => (
        <div
          class:list={[
            'reveal group flex items-center gap-4 bg-white border border-border rounded-xl px-5 py-5 shadow-card hover:shadow-card-hover transition-all duration-500 cursor-default',
            i === beneficios.length - 1 && 'sm:col-span-2',
          ]}
          data-delay={String(i + 1)}
        >
          <span class="text-3xl shrink-0 transition-transform duration-500 group-hover:scale-105">{b.emoji}</span>
          <div class="min-w-0">
            <h3 class="font-semibold text-ink text-base leading-snug">{b.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed mt-1">{b.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="reveal text-center mt-12">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-lead-tipo="day_use_escolar"
        data-fb-event="Contact"
        class="flex sm:inline-flex w-full sm:w-auto items-center justify-center gap-3 font-bold px-6 sm:px-10 py-4 rounded-xl text-sm sm:text-base text-white transition-all duration-200 shadow-lg hover:shadow-2xl hover:-translate-y-0.5"
        style="background: linear-gradient(135deg, #b7791f 0%, #d4952a 100%);"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Falar sobre o Day Use Escolar
      </a>
      <p class="text-text-muted text-sm mt-4">
        Atendimento exclusivo para escolas e grupos, com orçamento montado por turma.
      </p>
    </div>
  </div>
</section>
