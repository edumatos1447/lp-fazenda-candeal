---
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[100] px-4 pb-4 sm:pb-6 flex justify-center pointer-events-none hidden"
>
  <div class="pointer-events-auto w-full max-w-5xl bg-white border border-gray-200 rounded-xl shadow-xl px-5 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <p class="text-sm text-gray-700 flex-1">
      Usamos cookies para melhorar sua experiência e exibir anúncios relevantes.
      Ao continuar navegando, você concorda com nossa
      <a href="#" class="underline text-primary">política de privacidade</a>.
    </p>
    <div class="flex gap-3 shrink-0">
      <button
        id="cookie-reject"
        class="text-sm px-4 py-2 border border-gray-300 rounded-md text-gray-600 hover:bg-gray-50 transition-colors"
      >
        Recusar
      </button>
      <button
        id="cookie-accept"
        class="text-sm px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark transition-colors"
      >
        Aceitar todos
      </button>
    </div>
  </div>
</div>

<script define:vars={{ googleAdsId }}>
  const STORAGE_KEY = 'cookie_consent';

  function loadTracking() {
    // Google Ads / GA4
    if (googleAdsId) {
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', googleAdsId);
    }
  }

  const banner = document.getElementById('cookie-banner');
  const consent = localStorage.getItem(STORAGE_KEY);

  if (consent === 'true') {
    loadTracking();
  } else if (consent === null) {
    banner.classList.remove('hidden');
  }

  document.getElementById('cookie-accept').addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'true');
    banner.classList.add('hidden');
    loadTracking();
  });

  document.getElementById('cookie-reject').addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'false');
    banner.classList.add('hidden');
  });
</script>
