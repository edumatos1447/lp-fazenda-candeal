---
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '5571999990000';
const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Olá! Quero saber mais sobre a Fazenda Hotel Candeal.')}`;
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark text-white">
  <!-- CTA strip -->
  <div class="border-b border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-4">
        Pronto para sua experiência na fazenda?
      </h2>
      <p class="text-white/70 mb-8 max-w-lg mx-auto">
        Vagas limitadas por período. Reserve agora e garanta sua estada na Fazenda Hotel Candeal.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#reserva"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent/90 text-white font-bold px-8 py-4 rounded-lg text-base transition-colors duration-200 shadow-lg"
        >
          Ver datas disponíveis
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-8 py-4 rounded-lg text-base transition-colors duration-200"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Falar pelo WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Footer info -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <p class="font-serif font-bold text-xl mb-2">Fazenda Hotel Candeal</p>
        <p class="text-white/60 text-sm leading-relaxed">
          Turismo rural em Conceição do Jacuípe, Bahia.<br />
          A 100 km de Salvador e 30 km de Feira de Santana.<br />
          Natureza, gastronomia e conforto para toda a família.
        </p>
      </div>

      <!-- Contato -->
      <div>
        <p class="font-sans font-medium mb-3 text-xs uppercase tracking-[0.1em] text-white/50">Contato</p>
        <ul class="space-y-2 text-sm text-white/70">
          <li>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Conceição do Jacuípe, BA
          </li>
        </ul>
      </div>

      <!-- Links rápidos -->
      <div>
        <p class="font-sans font-medium mb-3 text-xs uppercase tracking-[0.1em] text-white/50">Navegação</p>
        <ul class="space-y-2 text-sm text-white/70">
          {[
            { label: 'O que oferecemos', href: '#amenidades' },
            { label: 'Galeria', href: '#galeria' },
            { label: 'Fazer reserva', href: '#reserva' },
            { label: 'Day Use', href: '#day-use' },
            { label: 'Dúvidas frequentes', href: '#faq' },
          ].map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/40">
      <p>© {currentYear} Fazenda Hotel Candeal. Todos os direitos reservados.</p>
      <p>Conceição do Jacuípe — Bahia — Brasil</p>
    </div>
  </div>
</footer>
