---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import VideoSection from '../components/VideoSection.astro';
import AmenitiesSection from '../components/AmenitiesSection.astro';
import RoomsSection from '../components/RoomsSection.astro';
import GallerySection from '../components/GallerySection.astro';
import ReservationSection from '../components/ReservationSection.astro';
import DayUseSection from '../components/DayUseSection.astro';
import SchoolDayUseSection from '../components/SchoolDayUseSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FooterSection from '../components/FooterSection.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import WhatsAppLeadModal from '../components/WhatsAppLeadModal';

const sheetsWebhookUrl = import.meta.env.PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL || '';
---

<Layout>
  <StickyHeader />
  <HeroSection />
  <VideoSection />
  <AmenitiesSection />
  <RoomsSection />
  <GallerySection />
  <ReservationSection />
  <DayUseSection />
  <SchoolDayUseSection />
  <TestimonialsSection />
  <FAQSection />
  <FooterSection />
  <FloatingWhatsApp />
  <WhatsAppLeadModal client:load sheetsWebhookUrl={sheetsWebhookUrl} />
</Layout>
